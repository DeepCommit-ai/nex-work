+/// [NexWork] The embedded migrator, except that an applied migration whose stored checksum is the
+/// same SQL with the other line endings keeps that checksum; `None` when nothing needs it.
+///
+/// AionCore's official Windows binaries embed migrations checked out with CRLF, while NexWork
+/// builds AionCore from source with LF on every platform. The SQL is identical, but sqlx checksums
+/// the bytes, so a database created by NexWork 2.1.61 (official binary) failed to open in
+/// 2.1.61-nexwork.2 and later with "migration 1 was previously applied but has been modified".
+/// The stored checksums are left as they are, so the other build can still open the database.
+async fn line_ending_tolerant_migrator(conn: &mut sqlx::SqliteConnection) -> Result<Option<Migrator>, DbError> {
+    let has_table: bool =
+        sqlx::query_scalar("SELECT COUNT(*) > 0 FROM sqlite_master WHERE type = 'table' AND name = '_sqlx_migrations'")
+            .fetch_one(&mut *conn)
+            .await
+            .map_err(DbError::Query)?;
+    if !has_table {
+        return Ok(None);
+    }
+    let stored: HashMap<i64, Vec<u8>> =
+        sqlx::query_as::<_, (i64, Vec<u8>)>("SELECT version, checksum FROM _sqlx_migrations")
+            .fetch_all(&mut *conn)
+            .await
+            .map_err(DbError::Query)?
+            .into_iter()
+            .collect();
+    let mut tolerated = Vec::new();
+    let migrations: Vec<Migration> = DB_MIGRATOR
+        .iter()
+        .map(|m| match stored.get(&m.version) {
+            Some(applied)
+                if !m.migration_type.is_down_migration()
+                    && applied.as_slice() != m.checksum.as_ref()
+                    && same_sql_other_line_endings(m, applied) =>
+            {
+                tolerated.push(m.version);
+                Migration {
+                    checksum: Cow::Owned(applied.clone()),
+                    ..m.clone()
+                }
+            }
+            _ => m.clone(),
+        })
+        .collect();
+    if tolerated.is_empty() {
+        return Ok(None);
+    }
+    info!(
+        versions = ?tolerated,
+        "Migrations were applied with the other line endings (official AionCore build); accepting them unchanged"
+    );
+    Ok(Some(Migrator {
+        migrations: Cow::Owned(migrations),
+        ignore_missing: DB_MIGRATOR.ignore_missing,
+        locking: DB_MIGRATOR.locking,
+        no_tx: DB_MIGRATOR.no_tx,
+    }))
+}
+
+/// Whether `checksum` is sqlx's checksum of `migration`'s SQL with LF or CRLF line endings.
+fn same_sql_other_line_endings(migration: &Migration, checksum: &[u8]) -> bool {
+    let lf = migration.sql.replace("\r\n", "\n");
+    let crlf = lf.replace('\n', "\r\n");
+    [lf, crlf].into_iter().any(|sql| {
+        let variant = Migration::new(
+            migration.version,
+            migration.description.clone(),
+            migration.migration_type,
+            Cow::Owned(sql),
+            migration.no_tx,
+        );
+        variant.checksum.as_ref() == checksum
+    })
+}
