+    /// Stamp every applied migration with the checksum of its SQL in CRLF form, as the official
+    /// Windows build of AionCore stores it.
+    async fn stamp_crlf_checksums(pool: &SqlitePool) {
+        for m in DB_MIGRATOR.iter().filter(|m| !m.migration_type.is_down_migration()) {
+            let crlf = m.sql.replace("\r\n", "\n").replace('\n', "\r\n");
+            let variant = Migration::new(
+                m.version,
+                m.description.clone(),
+                m.migration_type,
+                Cow::Owned(crlf),
+                m.no_tx,
+            );
+            sqlx::query("UPDATE _sqlx_migrations SET checksum = ? WHERE version = ?")
+                .bind(variant.checksum.as_ref())
+                .bind(m.version)
+                .execute(pool)
+                .await
+                .unwrap();
+        }
+    }
+
+    async fn stored_checksum(pool: &SqlitePool, version: i64) -> Vec<u8> {
+        sqlx::query_scalar("SELECT checksum FROM _sqlx_migrations WHERE version = ?")
+            .bind(version)
+            .fetch_one(pool)
+            .await
+            .unwrap()
+    }
+
+    #[tokio::test]
+    async fn database_from_a_crlf_build_opens_unchanged() {
+        let db = init_database_memory().await.unwrap();
+        let pool = db.pool();
+        stamp_crlf_checksums(pool).await;
+        let crlf_first = stored_checksum(pool, 1).await;
+        assert_ne!(
+            crlf_first.as_slice(),
+            DB_MIGRATOR.iter().next().unwrap().checksum.as_ref()
+        );
+
+        // The embedded migrator alone refuses it, exactly as 2.1.61-nexwork.3 did on Windows.
+        let mut conn = pool.acquire().await.unwrap();
+        assert!(matches!(
+            DB_MIGRATOR.run(&mut *conn).await,
+            Err(sqlx::migrate::MigrateError::VersionMismatch(1))
+        ));
+        run_migrations_with_retry(&mut conn).await.unwrap();
+        drop(conn);
+
+        // Left as it was, so the CRLF build can still open it.
+        assert_eq!(stored_checksum(pool, 1).await, crlf_first);
+    }
+
+    #[tokio::test]
+    async fn a_really_modified_migration_is_still_refused() {
+        let db = init_database_memory().await.unwrap();
+        let pool = db.pool();
+        stamp_crlf_checksums(pool).await;
+        sqlx::query("UPDATE _sqlx_migrations SET checksum = ? WHERE version = 1")
+            .bind(vec![0u8; 48])
+            .execute(pool)
+            .await
+            .unwrap();
+
+        let mut conn = pool.acquire().await.unwrap();
+        let err = run_migrations_with_retry(&mut conn).await.unwrap_err();
+        assert!(matches!(
+            err,
+            DbError::Migration(sqlx::migrate::MigrateError::VersionMismatch(1))
+        ));
+    }
+
+    #[tokio::test]
+    async fn matching_database_uses_the_embedded_migrator() {
+        let db = init_database_memory().await.unwrap();
+        let mut conn = db.pool().acquire().await.unwrap();
+        assert!(line_ending_tolerant_migrator(&mut conn).await.unwrap().is_none());
+    }
